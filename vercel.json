{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/lead.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/confidentialite",
      "destination": "/confidentialite.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://grp-presentation.vercel.app https://ashkan-landing.vercel.app https://ashkan-landing-f8dw.vercel.app https://ashkan-landing-ojbl.vercel.app"
        }
      ]
    }
  ]
}
